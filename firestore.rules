rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: master_data
    // Fields: id, skpd, kode_skpd, program, kode_program, kegiatan, kode_kegiatan, sub_kegiatan, kode_sub_kegiatan, belanja, kode_belanja, anggaran, realisasi, pagu_spd
    //
    // Collection: realization_data
    // Fields: id, skpd, kode_skpd, program, kode_program, kegiatan, kode_kegiatan, sub_kegiatan, kode_sub_kegiatan, belanja, kode_belanja, realisasi, keterangan_dokumen
    //
    // Collection: spending_data
    // Fields: id, kode_belanja, belanja
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "noviharyanto062@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidMasterData(data) {
      return data.keys().hasAll(['id', 'skpd', 'kode_skpd', 'kode_belanja', 'anggaran']) &&
             data.id is string &&
             data.skpd is string &&
             data.kode_skpd is string &&
             data.kode_belanja is string &&
             data.anggaran is number;
    }

    function isValidRealizationData(data) {
      return data.keys().hasAll(['id', 'skpd', 'kode_skpd', 'kode_belanja', 'realisasi']) &&
             data.id is string &&
             data.skpd is string &&
             data.kode_skpd is string &&
             data.kode_belanja is string &&
             data.realisasi is number &&
             (!('keterangan_dokumen' in data) || data.keterangan_dokumen is string);
    }

    function isValidSpendingData(data) {
      return data.keys().hasAll(['id', 'kode_belanja', 'belanja']) &&
             data.id is string &&
             data.kode_belanja is string &&
             data.belanja is string;
    }

    function isValidHibahData(data) {
      return data.keys().hasAll(['id', 'kegiatan', 'sub_kegiatan', 'anggaran', 'spd', 'realisasi', 'sisa_spd', 'sisa_realisasi']) &&
             data.id is string &&
             data.kegiatan is string &&
             data.sub_kegiatan is string &&
             data.anggaran is number &&
             data.spd is number &&
             data.realisasi is number &&
             data.sisa_spd is number &&
             data.sisa_realisasi is number &&
             (!('kode_kegiatan' in data) || data.kode_kegiatan is string) &&
             (!('kode_sub_kegiatan' in data) || data.kode_sub_kegiatan is string) &&
             (!('kode_rekening' in data) || data.kode_rekening is string) &&
             (!('uraian' in data) || data.uraian is string) &&
             (!('penerima_hibah' in data) || data.penerima_hibah is string);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /master_data/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidMasterData(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /realization_data/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidRealizationData(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /spending_data/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidSpendingData(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /hibah_data/{id} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidHibahData(request.resource.data);
      allow delete: if isAuthenticated();
    }
  }
}
