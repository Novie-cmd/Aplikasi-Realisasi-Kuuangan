rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-all Deny Rule
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidMasterData(data) {
      return data.keys().hasAll(['id', 'skpd', 'kode_skpd', 'kode_belanja', 'anggaran']) &&
             data.id is string &&
             data.skpd is string &&
             data.kode_skpd is string &&
             data.kode_belanja is string &&
             data.anggaran is number;
    }

    function isValidRealizationData(data) {
      return data.keys().hasAll(['id', 'skpd', 'kode_skpd', 'kode_belanja', 'realisasi']) &&
             data.id is string &&
             data.skpd is string &&
             data.kode_skpd is string &&
             data.kode_belanja is string &&
             data.realisasi is number &&
             (!('keterangan_dokumen' in data) || data.keterangan_dokumen is string);
    }

    // Special allowance for custom list of spending_data keys
    function isValidSpendingData(data) {
      return data.keys().hasAll(['id', 'kode_belanja', 'belanja']) &&
             data.id is string &&
             data.kode_belanja is string &&
             data.belanja is string;
    }

    function isValidHibahData(data) {
      return data.keys().hasAll(['id', 'kegiatan', 'sub_kegiatan', 'anggaran', 'spd', 'realisasi', 'sisa_spd', 'sisa_realisasi']) &&
             data.id is string &&
             data.kegiatan is string &&
             data.sub_kegiatan is string &&
             data.anggaran is number &&
             data.spd is number &&
             data.realisasi is number &&
             data.sisa_spd is number &&
             data.sisa_realisasi is number &&
             (!('kode_kegiatan' in data) || data.kode_kegiatan is string) &&
             (!('kode_sub_kegiatan' in data) || data.kode_sub_kegiatan is string) &&
             (!('kode_rekening' in data) || data.kode_rekening is string) &&
             (!('uraian' in data) || data.uraian is string) &&
             (!('penerima_hibah' in data) || data.penerima_hibah is string);
    }

    // ===============================================================
    // Rules for isolated user documents & nested subcollections
    // ===============================================================

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /master_data/{id} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(id) && isValidMasterData(incoming());
        allow delete: if isOwner(userId);
      }

      match /realization_data/{id} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(id) && isValidRealizationData(incoming());
        allow delete: if isOwner(userId);
      }

      match /spending_data/{id} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(id) && isValidSpendingData(incoming());
        allow delete: if isOwner(userId);
      }

      match /hibah_data/{id} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(id) && isValidHibahData(incoming());
        allow delete: if isOwner(userId);
      }

      match /settings/{id} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(id);
        allow delete: if isOwner(userId);
      }
    }
  }
}
